{
  "name": "personal-productivity-tracker",
  "version": "0.1.0",
  "description": "Local agentic productivity tracker for macOS",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && npm run copy:ui",
    "copy:ui": "node scripts/copy-ui-assets.mjs",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "bootstrap": "node scripts/bootstrap-deps.mjs",
    "build:native": "node scripts/bootstrap-deps.mjs",
    "setup": "node scripts/bootstrap-deps.mjs --install && npm run build",
    "postinstall": "node scripts/bootstrap-deps.mjs",
    "app:bundle": "node scripts/make-app-bundle.mjs",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/credential-providers": "3.1106.0",
    "@aws/bedrock-token-generator": "1.1.0",
    "@modelcontextprotocol/sdk": "1.25.0",
    "@slack/socket-mode": "^2.0.6",
    "@slack/web-api": "^7.15.0",
    "aws4": "1.13.2",
    "better-sqlite3": "^11.10.0",
    "express": "^4.22.1",
    "node-pty": "1.0.0",
    "sql-context-presets-mcp": "1.3.1",
    "uuid": "^10.0.0",
    "vega": "6.3.1",
    "vega-embed": "7.1.0",
    "vega-lite": "6.4.3",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@types/aws4": "1.11.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.15",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "fast-check": "^3.23.2",
    "jsdom": "^29.1.1",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
